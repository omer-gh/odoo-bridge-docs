# Copy this file to .env and fill in what applies:
#
#   cp .env.example .env
#
# Only DASHBOARD_SECRET_KEY is required to start the containers. The Odoo
# connection (ODOO_URL/ODOO_DB/ODOO_USERNAME/ODOO_API_KEY) is optional here —
# the dashboard's first-run setup and its "Odoo connection" page let you
# configure that interactively after the containers are up, so you don't
# need your Odoo credentials on hand just to get started. See INSTALL.md
# and MANUAL.md for details.

# Required. Signs dashboard login sessions. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
DASHBOARD_SECRET_KEY=

# Alternative to the plain value above: point at a file (e.g. a Docker
# Swarm secret) containing the key instead. If both are set, the _FILE
# variant wins.
# DASHBOARD_SECRET_KEY_FILE=/run/secrets/dashboard_secret_key

# Optional — pre-seed the Odoo connection instead of setting it up via the
# dashboard's "Odoo connection" page after first login. Leave all four
# blank to configure interactively instead.
# ODOO_URL=https://your-odoo-instance.example.com
# ODOO_DB=your_database
# ODOO_USERNAME=bridge@your-odoo-instance.example.com
# ODOO_API_KEY=

# _FILE alternative for the Odoo API key, same idea as above.
# ODOO_API_KEY_FILE=/run/secrets/odoo_api_key

# Optional — the dashboard passphrase can also be pre-seeded via its own
# _FILE variant (used only on first run, when no passphrase is set yet).
# Normally you just choose one interactively on first visit instead.
# DASHBOARD_PASSPHRASE_FILE=/run/secrets/dashboard_passphrase

# Leave both off (0) until you're ready to allow writes/deletes — see
# MANUAL.md, "Turning on writes/deletes".
# ODOO_ALLOW_WRITE=0
# ODOO_ALLOW_DELETE=0

# Optional — comma-separated, case-insensitive field names to redact in
# the audit log (e.g. password,token). See SECURITY.md.
# AUDIT_REDACT_FIELDS=
